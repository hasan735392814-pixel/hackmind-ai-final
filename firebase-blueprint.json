    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User-scoped in-app notifications."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable audit trail."
    },
    "/aiUsage/{usageId}": {
      "schema": { "$ref": "#/entities/AIUsage" },
      "description": "Hybrid AI inference telemetry logs."
    },
    "/sponsors/{sponsorId}": {
      "schema": { "$ref": "#/entities/Sponsor" },
      "description": "Sponsor partnerships linked to hackathons."
    }
  }
}
