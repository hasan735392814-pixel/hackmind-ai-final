        "hackathonId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorId", "action", "targetCollection", "targetId", "createdAt"]
    },
    "AIUsage": {
      "title": "AIUsage",
      "description": "Hybrid AI inference telemetry record without raw sensitive prompts.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "taskName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "inferenceSource": { "type": "string", "enum": ["ON-DEVICE", "CLOUD", "LOCAL MODEL UNAVAILABLE", "FALLBACK TO CLOUD", "FAILED"] },
        "requestedMode": { "type": "string", "enum": ["prefer_on_device", "prefer_in_cloud", "only_on_device", "only_in_cloud"] },
        "modelId": { "type": "string", "maxLength": 120 },
        "durationMs": { "type": "number" },
        "fallbackOccurred": { "type": "boolean" },
        "status": { "type": "string", "enum": ["success", "failed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "taskName", "inferenceSource", "requestedMode", "durationMs", "fallbackOccurred", "status", "createdAt"]
    },
    "Sponsor": {
      "title": "Sponsor",
      "description": "Authorized sponsor record linked to a hackathon.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "hackathonId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "organizerId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sponsorUserId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "organizationName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "tier": { "type": "string", "enum": ["platinum", "gold", "silver", "community"] },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "websiteUrl": { "type": "string", "maxLength": 300 },
        "notes": { "type": "string", "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "hackathonId", "organizerId", "sponsorUserId", "organizationName", "tier", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Server-managed administrator role records."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public builder, organizer, judge, and sponsor profiles (no PII)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only PII and AI cloud consent preferences."
    },
    "/hackathons/{hackathonId}": {
      "schema": { "$ref": "#/entities/Hackathon" },
      "description": "Hackathon events, rubrics, tracks, and publication state."
    },
    "/registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/HackathonRegistration" },
      "description": "Participant registrations scoped to hackathons."
    },
    "/teams/{teamId}": {
      "schema": { "$ref": "#/entities/Team" },
      "description": "Hackathon builder teams."
    },
    "/teams/{teamId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/TeamMember" },
      "description": "Authoritative team membership subcollection."
    },
    "/teams/{teamId}/private/{docId}": {
      "schema": { "$ref": "#/entities/TeamJoinCodeSecret" },
