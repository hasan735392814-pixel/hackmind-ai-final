# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Web Client Configuration (Target project: hackmind-ai, database: (default))
# Copy to .env.local and fill values from Firebase Console -> Project Settings -> Your apps (Web)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="hackmind-ai.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="hackmind-ai"
VITE_FIREBASE_STORAGE_BUCKET="hackmind-ai.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Optional Analytics Measurement ID (leave unset in Google AI Studio if Analytics is not used)
# VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# Firebase App Check (ReCaptcha Enterprise site key for production attestation)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=""
# Optional local dev-only App Check debug token (never required in Google AI Studio or production)
# VITE_APPCHECK_DEBUG_TOKEN=""

# Optional Firebase AI Logic model overrides (also configurable via Firebase Remote Config)
VITE_FIREBASE_AI_CLOUD_MODEL="gemini-3.5-flash-lite"
VITE_FIREBASE_AI_HEAVY_CLOUD_MODEL="gemini-4-hydrogen"
